# Render backend demo: set these variables in the service environment.
# Supply a generated secret and the actual service hostname privately.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DB_ENGINE=sqlite
# Optional override; default preserves var/dev.sqlite3 under the project root.
# SQLITE_PATH=var/dev.sqlite3
# Docker persistent disk example: mount /app/var/sqlite and use this path.
# SQLITE_PATH=/app/var/sqlite/db.sqlite3
ALLOWED_HOSTS=your-service.onrender.com,localhost,127.0.0.1
TRUST_PROXY_HEADERS=true
SECURE_SSL_REDIRECT=true
DJANGO_SERVE_STATIC=true
# Configure the existing CORS/CSRF/LLM variables for your real frontend/provider.
# See docs/DEPLOYMENT.md. No MYSQL_* variables are needed in SQLite mode.
