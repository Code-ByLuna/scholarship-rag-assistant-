DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
# Keep mysql for a MySQL server; set sqlite for a single-instance demo (including Render).
DB_ENGINE=mysql
# Used only with sqlite; omit to retain var/dev.sqlite3. Parent directories are created.
# SQLITE_PATH=var/dev.sqlite3
MYSQL_DATABASE=scholarships
MYSQL_USER=scholarships
MYSQL_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
ALLOWED_HOSTS=your-scholarship-domain.example,backend
CORS_ALLOWED_ORIGINS=https://your-scholarship-domain.example
CSRF_TRUSTED_ORIGINS=https://your-scholarship-domain.example
TRUST_PROXY_HEADERS=true
SECURE_SSL_REDIRECT=true
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_DIR=/app/var/index
LLM_MAX_OUTPUT_TOKENS=2400
LLM_MAX_INPUT_CHARS=24000

# Local semantic classification + bounded retrieved evidence; keep query text private by default.
RAG_CONTEXT_MAX_CHARS=10000
RAG_HISTORY_MAX_CHARS=2000
RAG_LOG_QUERY_TEXT=false
# auto: one generation for simple lookups; review uncertainty/complexity. always: review every answer.
LLM_GROUNDING_REVIEW=auto
