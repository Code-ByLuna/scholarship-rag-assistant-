DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DB_ENGINE=mysql
MYSQL_DATABASE=scholarships
MYSQL_USER=scholarships
MYSQL_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
ALLOWED_HOSTS=your-scholarship-domain.example,backend
CORS_ALLOWED_ORIGINS=https://your-scholarship-domain.example
CSRF_TRUSTED_ORIGINS=https://your-scholarship-domain.example
TRUST_PROXY_HEADERS=true
SECURE_SSL_REDIRECT=true
LLM_PROVIDER=none
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_DIR=/app/var/index
LLM_MAX_OUTPUT_TOKENS=1800
LLM_MAX_INPUT_CHARS=24000
